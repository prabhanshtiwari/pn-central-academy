NODE_ENV=development
PORT=5000
# Paste your MongoDB connection string here. Use an Atlas DB user with least-privilege access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
SERVE_CLIENT=false
# Optional: choose these BEFORE the first server start. Otherwise, a secure admin password is generated.
ADMIN_EMAIL=admin@pncentralacademy.local
# ADMIN_PASSWORD=choose-a-long-unique-password
# Only set COOKIE_SAME_SITE=none if using a cross-site frontend/API deployment; then HTTPS is required.
COOKIE_SAME_SITE=lax

# Optional Google Sheets sync via the Apps Script web app in docs/google-sheets-webhook.gs.
# Enquiries remain saved in MongoDB if the sheet sync is not configured or temporarily fails.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Optional persistent image storage. When all three are set, gallery/faculty uploads use Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
